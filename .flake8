[flake8]
# 88 Compatible with black
max-line-length = 100
max-complexity = 10
exclude =
    .git,
    __pycache__,
    build,
    dist,
    *.egg-info,
    venv,
    .venv,
    .pytest_cache
per-file-ignores =
    # imported but unused
    __init__.py: F401
statistics = True
count = True
show-source = True
